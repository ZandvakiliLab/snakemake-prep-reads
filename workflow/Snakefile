# load configuration
# -----------------------------------------------------
configfile: "config/config.yml"


# load rules
# -----------------------------------------------------
include: "rules/common.smk"
include: "rules/get_fastq.smk"
include: "rules/trim.smk"
include: "rules/umi_extraction.smk"
include: "rules/qc.smk"


# container definition (optional)
# -----------------------------------------------------
containerized: "oras://ghcr.io/zandvakililab/snakemake-prep-reads:latest"


# optional messages, log and error handling
# -----------------------------------------------------
onstart:
    print("\n--- Analysis started ---\n")


onsuccess:
    print("\n--- Workflow finished! ---\n")


onerror:
    print("\n--- An error occurred! ---\n")


# target rules
# -----------------------------------------------------
rule all:
    default_target: True
    input:
        directory("results/multiqc"),
        expand(
            "results/fastqc/pre/{sample}_{read}_fastqc.{ext}",
            sample=samples.index,
            read=["read1", "read2"] if is_paired_end() else ["read1"],
            ext=["html", "zip"],
        )
